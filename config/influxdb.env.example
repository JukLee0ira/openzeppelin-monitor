## InfluxDB (optional persistence for blocks/events)
INFLUXDB_ENABLED=true
INFLUXDB_URL=http://149.102.157.42:8086
INFLUXDB_BUCKET=usdc_testdata_bucket
# INFLUXDB_ORG=your_org_name
#
# IMPORTANT: do NOT commit real tokens. Provide via local env or secret manager.
INFLUXDB_TOKEN=REPLACE_ME
#
# If true, the service will try to ensure the bucket exists on startup (requires token permissions).
INFLUXDB_INIT=false


